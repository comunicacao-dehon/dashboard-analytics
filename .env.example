# ─── Utxica — Variáveis de Ambiente ──────────────────────────────────────────
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA faça commit do .env com as chaves reais!

# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=seu_url_do_supabase
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_do_supabase

# ─── Meta (Instagram + Facebook) ─────────────────────────────────────────────
# Crie um app em https://developers.facebook.com
VITE_META_APP_ID=seu_meta_app_id_aqui
VITE_META_REDIRECT_URI=https://seu-dominio.com/auth/callback/meta

# ─── Google (YouTube) ────────────────────────────────────────────────────────
# Crie credenciais OAuth em https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=seu_google_client_id_aqui
VITE_GOOGLE_REDIRECT_URI=https://seu-dominio.com/auth/callback/google

# ─── Resend (Envio de Convites por E-mail) ──────────────────────────────────
# Crie a chave gratuita em https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_resend_aqui

# ─── Inteligência Artificial (Google Gemini) ─────────────────────────────────
# Obtenha uma chave grátis em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
